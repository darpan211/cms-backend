# Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=5000
NODE_ENV=development

# API Configuration
API_TITLE=Educational CMS API
API_VERSION=1.0.0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cms-backend

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-please
JWT_EXPIRY=7d


# Digital Ocean Configuration (when added)
DO_SPACES_ENDPOINT=your_endpoint
DO_SPACES_REGION=your_region
DO_SPACES_BUCKET=your_bucket_name
DO_SPACES_KEY=your_digital_ocean_key
DO_SPACES_SECRET=your_digital_ocean_secret_key
DO_SPACES_CDN=your_cdn_url


# AWS S3 Configuration
AWS_REGION=
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=cms-videos

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_URL_EXPIRY=900
STREAM_URL_EXPIRY=3600

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
